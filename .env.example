# عنوان الباك اند (Laravel API v1) — مثال: http://localhost:8000 أو https://api.sakina.app
# عند ضبطه يتصل التطبيق بالـAPI الحقيقي مباشرة؛ فارغ مع VITE_API_MOCK=false = عبر بروكسي /api
VITE_API_URL=

# هدف بروكسي Vite لمسار /api (الافتراضي باك اند الاختبار)
VITE_API_PROXY_TARGET=http://api.sakinatherapy.app

# أجبر العمل ببيانات mock حتى لو كان VITE_API_URL مضبوطاً (للتطوير)
VITE_API_MOCK=true
